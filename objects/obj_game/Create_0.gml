randomize();
window_set_caption("DEAD FREQUENCY");window_set_size(1440,810);window_center();
display_set_gui_size(960,540);gpu_set_texfilter(false);window_set_cursor(cr_none);
game_set_speed(60,gamespeed_fps);
font_small=font_add("mono.ttf",11,false,false,32,1105);
font_dialogue=font_add("ui.ttf",20,false,false,32,1105);
font_ui=font_add("ui.ttf",16,true,false,32,1105);
font_big=font_add("title.ttf",53,false,false,32,1105);
font_title=font_add("title.ttf",82,false,false,32,1105);
pink=col(0xf086a5);cream=col(0xf0e1cc);mint=col(0x8cddc8);ink=col(0x101421);muted_col=col(0xa4a7b8);
actors=[];for(var i=0;i<6;i++)array_push(actors,sprite_add("actor"+string(i)+".png",8,false,false,20,20));
backgrounds=[];for(var i=0;i<6;i++)array_push(backgrounds,sprite_add("level"+string(i)+".png",1,false,false,0,0));
upper_backgrounds=[];for(var i=0;i<6;i++)array_push(upper_backgrounds,sprite_add("upper"+string(i)+".png",1,false,false,0,0));
portraits=[];for(var i=0;i<3;i++)array_push(portraits,sprite_add("portrait"+string(i)+".png",2,false,false,0,0));
glow_sprite=sprite_add("glow.png",1,false,false,64,64);title_sprite=sprite_add("title.png",1,false,false,0,0);
vignette_sprite=sprite_add("vignette.png",1,false,false,0,0);
var data_buffer=buffer_load("levels.json");level_data=json_parse(buffer_read(data_buffer,buffer_text));buffer_delete(data_buffer);
var story_buffer=buffer_load("story.json");story_data=json_parse(buffer_read(story_buffer,buffer_text));buffer_delete(story_buffer);
level_names=["PALM MOTOR INN","CLUB LOWLIFE","CHANNEL 09","HARBOR STORAGE","AFTER HOURS","LAST CALL"];
level_subtitles=["23:48 / ПОСЛЕДНИЙ ПОСТОЯЛЕЦ","00:16 / ПОСЛЕ ЗАКРЫТИЯ","01:03 / МЕРТВЫЙ ЭФИР","02:12 / ГРУЗ БЕЗ МАРКИРОВКИ","03:27 / ГРЯЗНАЯ РАБОТА","04:44 / ПОСЛЕДНИЙ ЗВОНОК"];
weapon_sprite=sprite_add("weapons.png",4,false,false,8,8);
blood_sprite=sprite_add("blood.png",8,false,false,16,16);
ini_open("dead_frequency.ini");unlocked=clamp(ini_read_real("game","unlocked",0),0,5);best=ini_read_real("game","best",0);
assist=ini_read_real("settings","assist",0);muted=ini_read_real("settings","muted",0);
shake_on=ini_read_real("settings","shake",1);blood_on=ini_read_real("settings","blood",1);wallet=max(0,ini_read_real("economy","cash",0));owned_weapons=ini_read_real("economy","owned",1)|1;
selected_weapon=clamp(ini_read_real("economy","selected",0),0,2);if((owned_weapons&(1<<selected_weapon))==0)selected_weapon=0;
armor_ready=ini_read_real("economy","armor",0);hub_next=clamp(ini_read_real("economy","next",0),0,unlocked);ini_close();
payout=0;arrival_timer=0;shop_message="";
workshop_sprite=sprite_add("workshop.png",1,false,false,0,0);
var hub_buffer=buffer_load("workshop.json");workshop_data=json_parse(buffer_read(hub_buffer,buffer_text));buffer_delete(hub_buffer);
state="menu";music_channel=audio_play_sound(snd_night_drive,0,true);selected_level=0;deaths=0;ticks=0;pickup_near=-1;
noise_x=0;noise_y=0;death_timer=0;
view_enabled=true;view_visible[0]=true;
camera=camera_create_view(0,0,640,360,0,noone,-1,-1,-1,-1);view_camera[0]=camera;
view_wport[0]=960;view_hport[0]=540;
nav_cache=array_create(array_length(level_data)*2,undefined);
load_level(0);state="menu";set_music();
// Automated smoke checks are opt-in command line arguments, never player cheats.
test_mode=false;for(var i=1;i<=parameter_count();i++)if(parameter_string(i)=="--smoke-test")test_mode=true;
test_frame=0;test_failures=[];test_step_us=0;test_step_max_us=0;test_step_samples=0;

perf_mode=false;for(var i=1;i<=parameter_count();i++)if(parameter_string(i)=="--perf-test")perf_mode=true;
if(perf_mode)test_mode=true;
perf_frame=0;perf_cpu=[];perf_delta=[];perf_draw=[];perf_nav=[];perf_draw_start=0;
